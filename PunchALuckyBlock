MainTab:CreateToggle({
    Name = "Instant Interact",
    CurrentValue = false,
    Callback = function(Value)
        getgenv().InstantInteract = Value

        while getgenv().InstantInteract do
            pcall(function()
                for _,v in pairs(workspace:GetDescendants()) do
                    if v:IsA("ProximityPrompt") then
                        v.HoldDuration = 0
                    end
                end
            end)

            task.wait(1)
        end
    end
})

-- =========================
-- RESPAWN SAME PLACE
-- =========================

local RespawnEnabled = false
local LastPosition = nil

MainTab:CreateToggle({
    Name = "Respawn Same Place",
    CurrentValue = false,
    Callback = function(Value)
        RespawnEnabled = Value
    end
})

player.CharacterAdded:Connect(function(character)

    local humanoidRootPart = character:WaitForChild("HumanoidRootPart")
    local humanoid = character:WaitForChild("Humanoid")

    humanoid.Died:Connect(function()
        if RespawnEnabled and humanoidRootPart then
            LastPosition = humanoidRootPart.CFrame
        end
    end)

    if RespawnEnabled and LastPosition then
        task.wait(0.5)

        local newRoot = character:WaitForChild("HumanoidRootPart")
        newRoot.CFrame = LastPosition
    end
end)
