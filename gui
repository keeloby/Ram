-- Fungsi pembuat tombol toggle sederhana
local function createButton(text, callback)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, 0, 0, 32)
	btn.BackgroundColor3 = Color3.fromRGB(25, 35, 50)
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(220, 220, 220)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 10
	btn.Parent = mainFrame
	
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = btn
	
	btn.MouseButton1Click:Connect(callback)
	return btn
end

-- 1. Tombol Anti TP-Back
local tpState = false
createButton("🛡️ Toggle Anti TP-Back", function()
	tpState = not tpState
	AeroEngine.ToggleAntiTpBack(tpState)
	print("Anti TP-Back:", tpState)
end)

-- 2. Tombol Noclip
local noclipState = false
createButton("👻 Toggle Noclip", function()
	noclipState = not noclipState
	AeroEngine.ToggleNoclip(noclipState)
	print("Noclip:", noclipState)
end)

-- 3. Tombol Remote Spam (Contoh: Training_TapBonus dengan Argument {2})
local spamState = false
createButton("📡 Toggle Spam Training_TapBonus", function()
	spamState = not spamState
	if spamState then
		-- Mengatur Delay Spam
		AeroEngine.SpamDelay = 0.1 
		
		-- Eksekusi Remote menggunakan argument kustom sesuai permintaanmu
		AeroEngine.StartRemoteSpam(function(args)
			ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Training_TapBonus"):InvokeServer(unpack(args))
		end, {2}) -- Arguments {2} dikirim di sini
		
		print("Remote Spam Dimulai!")
	else
		AeroEngine.StopRemoteSpam()
		print("Remote Spam Dihentikan!")
	end
end)

