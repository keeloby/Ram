------------------------------------------------
-- FITUR MINIMIZE WINDOW (FIXED)
------------------------------------------------
local IsMinimized = false
MinimizeBtn.MouseButton1Click:Connect(function()
    IsMinimized = not IsMinimized
    if IsMinimized then
        ContentFrame.Visible = false
        MainFrame:TweenSize(UDim2.new(0, 320, 0, 40), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.3, true)
        MinimizeBtn.Text = "[+]"
    else
        MainFrame:TweenSize(UDim2.new(0, 320, 0, 420), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.3, true, function()
            ContentFrame.Visible = true
        end)
        MinimizeBtn.Text = "[-]"
    end
end)
